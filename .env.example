# Copy this file to `.env` and fill in values. `.env` is gitignored.

# --- Database (PostgreSQL / Supabase) -----------------------------------------
# DATABASE_URL  = the POOLED connection (Supabase "Transaction pooler", port 6543).
#                 Used by the app at runtime — safe for serverless/Vercel.
# DIRECT_URL    = the DIRECT connection (Supabase "Session"/direct, port 5432).
#                 Used only for migrations (`npm run db:migrate` / `db:seed`).
#
# In Supabase: Project → Connect → ORMs/Prisma shows both strings. Replace
# [YOUR-PASSWORD] with your database password.
#
# Example shapes (host/refs will differ):
#   DATABASE_URL="postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""

# --- Auth.js (NextAuth v5) ----------------------------------------------------
# Required. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional: Google SSO. When both are set, the "Continue with Google" provider
# turns on automatically. Add <your-domain>/api/auth/callback/google (and
# http://localhost:3000/api/auth/callback/google for local) as authorized
# redirect URIs in the Google Cloud console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
