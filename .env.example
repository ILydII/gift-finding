# Copy this file to `.env` and fill in values. `.env` is gitignored.
# Everything except DATABASE_URL and AUTH_SECRET is optional for local dev.

# --- Database -----------------------------------------------------------------
# Local SQLite file (default). The file is created by `npm run db:migrate`.
# To move to Postgres later: change the datasource provider in
# prisma/schema.prisma, swap the driver adapter in src/lib/prisma.ts, and set a
# Postgres connection string here.
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth v5) ----------------------------------------------------
# Required. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional: Google SSO. When both are set, the "Continue with Google" provider
# turns on automatically. Get credentials from the Google Cloud console and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
